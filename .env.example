# Configuración de docker-compose y servicios. Copiar a .env y ajustar.
# Nunca commitear el archivo .env real.

# PostgreSQL
POSTGRES_USER=digesto
POSTGRES_PASSWORD=digesto_dev
POSTGRES_DB=digesto

# API
ASPNETCORE_ENVIRONMENT=Development

# Almacenamiento de archivos (dentro de los contenedores)
FILE_STORAGE_ROOT=/data/archivos

# Ingesta de PDFs
INGESTA_TAMANIO_MAX_MB=50
INGESTA_UMBRAL_CARACTERES_PAGINA=100
