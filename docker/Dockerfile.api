# Etapa 1: build (restore cacheado por csproj)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /f
COPY src/Digesto.Domain/Digesto.Domain.csproj Digesto.Domain/
COPY src/Digesto.Application/Digesto.Application.csproj Digesto.Application/
COPY src/Digesto.Infrastructure/Digesto.Infrastructure.csproj Digesto.Infrastructure/
COPY src/Digesto.Api/Digesto.Api.csproj Digesto.Api/
RUN dotnet restore Digesto.Api/Digesto.Api.csproj
COPY src/ .
RUN dotnet publish Digesto.Api/Digesto.Api.csproj -c Release -o /app/publish

# Etapa 2: runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Digesto.Api.dll"]
