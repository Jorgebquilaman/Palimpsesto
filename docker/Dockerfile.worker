# Etapa 1: build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY DigestoIupa.slnx ./
COPY src/ src/
RUN dotnet restore
RUN dotnet publish src/Digesto.Worker -c Release -o /app/publish --no-restore

# Etapa 2: runtime con herramientas de PDF/OCR
FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    ocrmypdf \
    tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*

# Usuario sin privilegios y sin acceso a red de salida
RUN useradd --create-home --uid 1001 worker
USER worker

WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Digesto.Worker.dll"]
