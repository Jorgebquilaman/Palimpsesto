# Etapa 1: build (restore cacheado por csproj)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /f
COPY src/Digesto.Domain/Digesto.Domain.csproj Digesto.Domain/
COPY src/Digesto.Application/Digesto.Application.csproj Digesto.Application/
COPY src/Digesto.Infrastructure/Digesto.Infrastructure.csproj Digesto.Infrastructure/
COPY src/Digesto.Worker/Digesto.Worker.csproj Digesto.Worker/
RUN dotnet restore Digesto.Worker/Digesto.Worker.csproj
COPY src/ .
RUN dotnet publish Digesto.Worker/Digesto.Worker.csproj -c Release -o /app/publish

# Etapa 2: runtime con herramientas de PDF/OCR
FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    ocrmypdf \
    tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1001 worker
USER worker

WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Digesto.Worker.dll"]
